NODE_ENV=development

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

BASE_URL=https://web.telegram.org/a/

# --- BRANDING -----------------------------------------------------------------
# Every value below falls back to Telegram's own when it is empty, so a checkout
# with no .env builds and behaves exactly as upstream does. Fill them in to run
# this client under your own name and domain.
#
# APP_NAME          the app's name, shown in the main menu footer, in the
#                   notification title and as the shared worker's name.
# APP_TITLE         the document title, the installed-app title, the manifest
#                   title and the og:/twitter: title.
# APP_DESCRIPTION   the meta description and the og:/twitter: description.
# APP_HOST          the host this build is served from. It gates the cross-version
#                   links to Web K/Z, the permanent-version redirect and the
#                   `IS_PRODUCTION_HOST` checks.
# SHORT_DOMAIN      the short domain every link the app builds or opens starts
#                   with — the one place usernames, invite links, gift links and
#                   shared-message links are assembled.
# APP_PROTOCOL      the scheme a `resolve` deep link uses.
# THEME_COLOR       the `theme-color` meta tag.
# TILE_COLOR        the Windows tile colour (`msapplication-TileColor`).
#                   Quote both: an unquoted `#` starts a comment in dotenv, so
#                   `THEME_COLOR=#ffffff` parses as an empty value.
# WEBSYNC_ENABLED   set to 0 to stop the client pinging Telegram's `/_websync_`
#                   endpoint, which tells Telegram's edge that a web session is
#                   live and lets it redirect between Web A and Web K. Off by
#                   default once SHORT_DOMAIN is set, since that endpoint is
#                   Telegram's and a branded host does not serve it.
APP_NAME=
APP_TITLE=
APP_DESCRIPTION=
APP_HOST=
SHORT_DOMAIN=
APP_PROTOCOL=
THEME_COLOR=
TILE_COLOR=